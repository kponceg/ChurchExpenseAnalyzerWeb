# Public Supabase project settings. These values are safe for browser use,
# but use placeholders in source control and configure real values in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase secret. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key

# Public origin of this deployment. Do not include a trailing slash.
# For local development, use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
